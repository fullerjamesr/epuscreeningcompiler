{% extends "base.html.j2" %}

{% block title %}{{ session_name }} : GridSquare_{{ gs_id }}{% endblock %}

{% block style %}
    :root {
      --gap: 8px;  /* column gap == tabs-to-image gap on this page */
      /* The exposure is square, so let it grow to use the window height (the 146px is the page header, tab row, file
         name, gaps and padding around it, plus a few px of slack), but never get smaller than 820px. */
      --exposure-size: max(820px, calc(100vh - 146px));
      /* The context column starts level with the tab row, 40px (32px row + 8px gap) above the exposure, and its bottom
         should not go below the exposure's: the grid square and foil-hole panels (square, each with a 32px caption and
         an 8px gap below it, and a 20px gap between the two) must satisfy 2 * (32 + 8 + width) + 20 <= exposure-size + 40. */
      --context-max: calc((var(--exposure-size) - 60px) / 2);
    }
    /* As wide as the atlas page (its 800px / 132px / 560px / 48px, see session_index.html.j2), but no wider than the
       exposure, the context column at its maximum, the gap and the padding need. */
    .page { max-width: min(calc(max(800px, 100vh - 132px) + var(--gap) + 560px + 48px),
                           calc(var(--exposure-size) + var(--gap) + var(--context-max) + 48px)); }

    a.field-value { text-decoration: none; }
    .square-nav { display: flex; align-items: center; gap: 10px; }
    .nav-btn { width: 24px; height: 24px; border: 1px solid var(--border-strong); border-radius: 6px; display: flex; align-items: center; justify-content: center; color: var(--text); }
    .nav-btn:hover { border-color: var(--muted); color: var(--text); }

    /* ---------- layout: small context column left, exposure right ---------- */
    .layout { display: flex; flex-wrap: wrap; gap: var(--gap); align-items: flex-start; }
    .context-col { flex: 1 1 280px; max-width: var(--context-max); display: flex; flex-direction: column; gap: 20px; }
    /* the exposure column takes the free width only up to the exposure size; the rest goes to the context column (up to its max) */
    .exposure-col { flex: 999 1 520px; max-width: var(--exposure-size); min-width: 0; display: flex; flex-direction: column; gap: var(--gap); }
    figure { margin: 0; display: flex; flex-direction: column; gap: var(--gap); }
    /* the 32px box matches the tab row so the panels start level with the exposure; the text sits at the bottom of it
       (tight line-height) so the visible gap to the image is just the --gap */
    figcaption { font-size: 16px; font-weight: 600; line-height: 1; min-height: 32px; display: flex; align-items: flex-end; }
    .panel { position: relative; width: 100%; aspect-ratio: 1; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: #000; }
    .panel > img, .zoom-inner > img { width: 100%; height: 100%; display: block; }
    .zoomable { cursor: zoom-in; }   /* set by setupZoom() */
    .zoomable > img, .zoom-inner { transform-origin: 0 0; }   /* what setupZoom() transforms: the image, or the wrapper around image + rings */
    .zoom-inner { position: absolute; inset: 0; }
    .panel.empty { background: transparent; border-style: dashed; border-color: var(--border-strong); display: flex; align-items: center; justify-content: center; color: var(--faint); font-size: 13px; }

    /* hole rings on the grid square: the real hole radius, no fill, no label */
    /* --px (set by setupZoom) is one screen pixel in image pixels: the rings are zoomed with the image, so their line widths are scaled back down by it */
    .panel svg { position: absolute; inset: 0; width: 100%; height: 100%; --px: 1; }
    .hole .hit { fill: transparent; cursor: pointer; }
    .hole .ring { fill: none; stroke: var(--accent); stroke-width: calc(2 * var(--px)); pointer-events: none; }
    /* thin black border: a wider black circle under the ring, 1px wider on each side, so the ring stands out on any image */
    .hole .halo { fill: none; stroke: #000; stroke-width: calc(4 * var(--px)); pointer-events: none; }
    .hole:hover .ring { stroke: var(--link-hover); }
    .hole.selected .ring { stroke: var(--selected); stroke-width: calc(3 * var(--px)); }
    .hole.selected .halo { stroke-width: calc(5 * var(--px)); }
    .hole:focus { outline: none; }
    .hole:focus-visible .ring { stroke-width: calc(4 * var(--px)); }
    .hole:focus-visible .halo { stroke-width: calc(6 * var(--px)); }

    /* hole tabs */
    .tabs { display: flex; flex-wrap: wrap; gap: 6px; min-height: 32px; align-items: center; }
    .tab { display: flex; align-items: center; gap: 8px; height: 32px; padding: 0 12px 0 6px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--panel); cursor: pointer; }
    .tab[aria-selected="true"] { border-color: var(--selected); background: var(--tab-on); }
    .tab-num { width: 22px; height: 22px; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font: 500 12px/1 var(--mono); display: flex; align-items: center; justify-content: center; }
    .tab[aria-selected="true"] .tab-num { background: var(--selected); }
    .tab-id { font: 13px/1 var(--mono); }

    /* exposure viewer */
    .exposure-list { display: flex; flex-direction: column; gap: 16px; }   /* multiple exposures stack vertically */
    .exposure-item { display: flex; flex-direction: column; gap: 6px; }
    .exposure { max-width: var(--exposure-size); }
    .file-name { max-width: var(--exposure-size); font: 12px/1.4 var(--mono); color: var(--muted); word-break: break-all; }
{% endblock %}

{% block header_left %}
      <div class="field no-rule">
        <div class="field-label">Session name</div>
        <a class="field-value" href="../index.html">← {{ session_name }}</a>
      </div>
      <div class="field">
        <div class="field-label">Grid square · {{ index }} of {{ n_gridsquares }}</div>
        <div class="square-nav">
          <a class="nav-btn" href="{{ prev.href }}" aria-label="Previous grid square, {{ prev.id }}" title="Previous: {{ prev.id }} ({{ prev.index }} of {{ n_gridsquares }})">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10 3L5 8l5 5"/></svg>
          </a>
          <h1 class="field-value mono">{{ gs_id }}</h1>
          <a class="nav-btn" href="{{ next.href }}" aria-label="Next grid square, {{ next.id }}" title="Next: {{ next.id }} ({{ next.index }} of {{ n_gridsquares }})">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg>
          </a>
        </div>
      </div>
{% endblock %}

{% block header_right %}
      <div class="field"><dt class="field-label">Holes</dt><dd class="field-value mono">{{ n_holes }}</dd></div>
      <div class="field"><dt class="field-label">Exposures</dt><dd class="field-value mono">{{ n_exposures }}</dd></div>
      <div class="field"><dt class="field-label">Foil-hole images</dt><dd class="field-value mono">{{ n_foilholes }}</dd></div>
      {% if collected %}
      <div class="field"><dt class="field-label">Collected</dt><dd class="field-value mono">{{ collected }}</dd></div>
      {% endif %}
{% endblock %}

{% block content %}
  <div class="layout">

    <aside class="context-col">
      <figure>
        <figcaption>Grid square</figcaption>
        <div class="panel" data-pixel-size="{{ gs_pixel_size }}">
          <div class="zoom-inner">
            <img id="gs-img" src="GridSquare_{{ gs_id }}.png" alt="Grid square {{ gs_id }} with imaged holes circled">
            <svg id="gs-svg" viewBox="0 0 {{ gs_width }} {{ gs_height }}" xmlns="http://www.w3.org/2000/svg">
              <!-- Rings are generated by JS from #hole-data (one <g class="hole"> per hole). -->
            </svg>
          </div>
          <div class="scalebar small"><div class="sb-bar"></div><span class="sb-label"></span></div>
        </div>
      </figure>

      <figure>
        <figcaption>Foil hole</figcaption>
        <div class="panel" id="fh-panel">
          <img id="fh-img" alt="">
          <div class="scalebar small"><div class="sb-bar"></div><span class="sb-label"></span></div>
        </div>
        <div class="panel empty" id="fh-empty" hidden>No foil-hole image for this hole</div>
      </figure>
    </aside>

    <section class="exposure-col" aria-label="Exposure">
      <div class="tabs" role="tablist" aria-label="Holes" id="tabs">
        <!-- Tabs are generated by JS from #hole-data. -->
      </div>
      <!-- One .exposure-item per exposure of the selected hole, stacked top to bottom (built by JS).
           Each has its own zoom/pan and scale bar. -->
      <div class="exposure-list" id="exposure-list"></div>
      <div class="panel exposure empty" id="exp-empty" hidden>No exposure recorded for this hole</div>
    </section>
  </div>
{% endblock %}

{% block script %}
<!-- The only per-hole data the page needs. Paths are relative to this page. -->
<script id="hole-data" type="application/json">{{ holes | tojson }}</script>

<script>
  // Scale bar for a static panel; returns a refresh function. The pixel size is read from the panel's
  // data-pixel-size each time, because the foil hole panel is reused for every hole.
  function scaleBarFor(panel, getScale) {
    var img = panel.querySelector('img'), bar = panel.querySelector('.sb-bar'), label = panel.querySelector('.sb-label');
    function refresh() { updateScaleBar(img, bar, label, parseFloat(panel.dataset.pixelSize), getScale ? getScale() : 1); }
    img.addEventListener('load', refresh);
    if (img.complete && img.naturalWidth) refresh();
    panel._ro = new ResizeObserver(refresh);   // kept so it can be disconnected when the panel is removed
    panel._ro.observe(panel);
    return refresh;
  }

  // ---------- zoom + pan on a panel (grid square, foil hole or exposure) ----------
  // Returns { refresh, reset }: refresh redraws the scale bar, reset goes back to 1x.
  function setupZoom(panel) {
    var img = panel.querySelector('img');
    var svg = panel.querySelector('svg');   // the ring overlay, grid square only
    var inner = panel.querySelector('.zoom-inner') || img;   // image and rings are moved by one transform, so they cannot drift apart
    var vbw = svg ? svg.viewBox.baseVal.width : 0;
    var s = 1, tx = 0, ty = 0, dragging = false, moved = false, justPanned = false, dx = 0, dy = 0, dtx = 0, dty = 0;
    var refreshBar = scaleBarFor(panel, function () { return s; });
    panel.classList.add('zoomable');
    function clamp() {
      var w = panel.clientWidth, h = panel.clientHeight;
      tx = Math.min(0, Math.max(tx, w - w * s)); ty = Math.min(0, Math.max(ty, h - h * s));
    }
    function apply() {
      inner.style.transform = s === 1 ? '' : 'translate(' + tx + 'px,' + ty + 'px) scale(' + s + ')';
      if (svg && panel.clientWidth) svg.style.setProperty('--px', vbw / (panel.clientWidth * s));   // keeps the ring line widths constant
      panel.style.cursor = dragging ? 'grabbing' : (s > 1 ? 'grab' : 'zoom-in');
      refreshBar();
    }
    panel.addEventListener('wheel', function (e) {
      e.preventDefault();
      var r = panel.getBoundingClientRect(), mx = e.clientX - r.left, my = e.clientY - r.top;
      var ns = Math.max(1, Math.min(10, s * (e.deltaY < 0 ? 1.15 : 1 / 1.15)));
      tx = mx - ns / s * (mx - tx); ty = my - ns / s * (my - ty); s = ns; clamp(); apply();
    }, { passive: false });
    panel.addEventListener('mousedown', function (e) {
      if (s <= 1 || e.button !== 0) return;
      e.preventDefault(); dragging = true; moved = false; dx = e.clientX; dy = e.clientY; dtx = tx; dty = ty;
    });
    panel.addEventListener('mousemove', function (e) {
      if (!dragging) return; tx = dtx + e.clientX - dx; ty = dty + e.clientY - dy; moved = true; clamp(); apply();
    });
    function end() {
      if (!dragging) return;
      dragging = false; apply();
      if (moved) { justPanned = true; setTimeout(function () { justPanned = false; }, 0); }   // the click that follows a drag
    }
    panel.addEventListener('mouseup', end);
    panel.addEventListener('mouseleave', end);
    // Swallow the click that ends a pan so it does not select the hole under the cursor (capture: runs before the ring's handler).
    panel.addEventListener('click', function (e) { if (justPanned) { justPanned = false; e.stopPropagation(); } }, true);
    function reset() { s = 1; tx = 0; ty = 0; apply(); }
    panel.addEventListener('dblclick', reset);
    if (svg) new ResizeObserver(function () { clamp(); apply(); }).observe(panel);   // tx/ty are in px, and --px depends on the panel size
    apply();   // sets --px for the initial size
    return { refresh: refreshBar, reset: reset };
  }

  // ---------- hole selection ----------
  (function () {
    var SVG = 'http://www.w3.org/2000/svg';
    var holes = JSON.parse(document.getElementById('hole-data').textContent);
    var svg = document.getElementById('gs-svg');
    var tabsEl = document.getElementById('tabs');
    var expList = document.getElementById('exposure-list'), expEmpty = document.getElementById('exp-empty');
    var fhPanel = document.getElementById('fh-panel'), fhEmpty = document.getElementById('fh-empty');
    var fhImg = document.getElementById('fh-img');

    setupZoom(document.getElementById('gs-img').closest('.panel'));
    var fhZoom = setupZoom(fhPanel);

    var rings = [], tabs = [];
    holes.forEach(function (h, i) {
      // ring: exact hole radius; invisible hit circle at least ~10 screen px so tiny holes stay clickable
      var g = document.createElementNS(SVG, 'g');
      g.setAttribute('class', 'hole');
      g.setAttribute('tabindex', '0');
      g.setAttribute('role', 'button');
      g.setAttribute('aria-label', 'Hole ' + h.id);
      var hit = document.createElementNS(SVG, 'circle');
      hit.setAttribute('class', 'hit'); hit.setAttribute('cx', h.cx); hit.setAttribute('cy', h.cy); hit.setAttribute('r', Math.max(h.r, 60));
      var halo = document.createElementNS(SVG, 'circle');   // black border under the ring
      halo.setAttribute('class', 'halo'); halo.setAttribute('cx', h.cx); halo.setAttribute('cy', h.cy); halo.setAttribute('r', h.r);
      var ring = document.createElementNS(SVG, 'circle');
      ring.setAttribute('class', 'ring'); ring.setAttribute('cx', h.cx); ring.setAttribute('cy', h.cy); ring.setAttribute('r', h.r);
      var t = document.createElementNS(SVG, 'title'); t.textContent = 'Hole ' + h.id;
      g.append(t, hit, halo, ring);
      g.addEventListener('click', function () { select(i); });
      g.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(i); } });
      svg.appendChild(g); rings.push(g);

      var tab = document.createElement('button');
      tab.type = 'button'; tab.className = 'tab'; tab.setAttribute('role', 'tab');
      tab.innerHTML = '<span class="tab-num">' + (i + 1) + '</span><span class="tab-id">' + h.id + '</span>';
      tab.addEventListener('click', function () { select(i); });
      tabsEl.appendChild(tab); tabs.push(tab);
    });

    function select(i) {
      var h = holes[i];
      rings.forEach(function (g, j) { g.classList.toggle('selected', j === i); });
      tabs.forEach(function (t, j) { t.setAttribute('aria-selected', j === i ? 'true' : 'false'); });

      // Rebuild the exposure stack: one zoomable panel + file name per exposure. Only the selected hole's images load.
      expList.querySelectorAll('.panel').forEach(function (p) { if (p._ro) p._ro.disconnect(); });
      expList.textContent = '';
      h.exposures.forEach(function (e, k) {
        var item = document.createElement('div');
        item.className = 'exposure-item';
        var panel = document.createElement('div');
        panel.className = 'panel exposure';
        panel.dataset.pixelSize = e.pixel_size;
        var img = document.createElement('img');
        img.src = e.path;
        img.alt = 'Exposure ' + (k + 1) + ' of ' + h.exposures.length + ', hole ' + h.id;
        panel.appendChild(img);
        panel.insertAdjacentHTML('beforeend', '<div class="scalebar"><div class="sb-bar"></div><span class="sb-label"></span></div>');
        var name = document.createElement('div');
        name.className = 'file-name';
        name.textContent = e.path.split('/').pop() + ' | ' + e.info;   // file name | magnification | pixel size
        item.append(panel, name);
        expList.appendChild(item);
        setupZoom(panel);
      });
      expEmpty.hidden = h.exposures.length > 0;

      fhPanel.hidden = !h.foilhole; fhEmpty.hidden = !!h.foilhole;
      if (h.foilhole) {
        fhPanel.dataset.pixelSize = h.foilhole.pixel_size;
        fhImg.src = h.foilhole.path; fhImg.alt = 'Foil-hole image, hole ' + h.id;
        fhZoom.reset();   // zoom starts fresh for each hole (this also refreshes the scale bar)
      }

      history.replaceState(null, '', '#hole-' + h.id);   // deep link to a hole
    }

    if (holes.length) {
      var fromHash = holes.findIndex(function (h) { return location.hash === '#hole-' + h.id; });
      select(fromHash >= 0 ? fromHash : 0);
    } else {   // a grid square without any holes: nothing to select
      expEmpty.hidden = false; fhPanel.hidden = true; fhEmpty.hidden = false;
    }
  })();
</script>
{% endblock %}
